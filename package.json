{
  "name": "wasdok360-ocpng",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:auth-security": "vitest run tests/security tests/foundation/server-auth-policy.test.ts tests/foundation/session-lifecycle.test.ts tests/foundation/auth-audit.test.ts tests/foundation/environment.test.ts",
    "test:auth-build": "node scripts/auth-build-regression.mjs",
    "verify:client-artifacts": "node scripts/check-client-artifacts.mjs",
    "test:domain": "node --experimental-strip-types scripts/domain-smoke.mjs",
    "test:schema": "node scripts/schema-smoke.mjs",
    "test:routes": "node scripts/routes-smoke.mjs",
    "test:rls": "supabase test db",
    "verify:static": "node scripts/static-security.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "archiver": "8.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
