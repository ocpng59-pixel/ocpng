{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "lib/config/**/*.ts",
    "lib/rbac/**/*.ts",
    "lib/cases/**/*.ts",
    "lib/leadership/**/*.ts",
    "lib/compliance/**/*.ts",
    "lib/reporting/**/*.ts"
  ]
}
